{
  "realm": "aegis",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clientScopes": [
    {
      "name": "notification:write",
      "description": "Submit notifications for delivery (docs/security/scopes.md)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "notification:read",
      "description": "Read notification delivery status (docs/security/scopes.md)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "audit:read",
      "description": "Read the audit trail (docs/security/scopes.md)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "user:read",
      "description": "List/query managed users (docs/security/scopes.md, forward-looking)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "user:admin",
      "description": "Create/update/disable managed users (docs/security/scopes.md, forward-looking)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "aegis-dev-cli",
      "name": "Local dev password-grant client",
      "description": "Used by the documented local JWT retrieval curl (README). Not for production use.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "notification:write",
        "notification:read",
        "audit:read",
        "user:read",
        "user:admin"
      ]
    },
    {
      "clientId": "aegis-user-service",
      "name": "aegis-user-service Admin REST client",
      "description": "Confidential service-account client used by aegis-user-service to call the Keycloak Admin REST API (Slice 5a/5b, issue #74). Local dev only. Granted view-users and manage-users for read and mutation endpoints.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "local-dev-only-secret",
      "defaultClientScopes": []
    },
    {
      "clientId": "aegis-admin-frontend",
      "name": "Aegis Admin Frontend",
      "description": "Public OpenID Connect client used by the Angular admin frontend for user authentication. Uses Authorization Code Flow with PKCE. Local development only.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200/silent-check-sso.html",
        "http://localhost:4200"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "+"
      ],
      "defaultClientScopes": [
        "notification:read",
        "notification:write",
        "audit:read"
      ]
    }
  ],
  "users": [
    {
      "username": "aegis-dev",
      "email": "aegis-dev@example.local",
      "firstName": "Aegis",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev123",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-aegis-user-service",
      "enabled": true,
      "serviceAccountClientId": "aegis-user-service",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users"]
      }
    }
  ]
}
