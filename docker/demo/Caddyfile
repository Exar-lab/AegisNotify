# Public entry point of the AWS demo. Caddy obtains and renews Let's Encrypt certificates for
# the two hostnames on its own. API_HOST and AUTH_HOST come from docker-compose.demo.yml.
{$API_HOST} {
	reverse_proxy aegis-api-gateway:8080
}

{$AUTH_HOST} {
	# Keep the Keycloak admin console and the master realm off the Internet. aegis-user-service
	# reaches the Admin API over the internal compose network, not through this proxy.
	@private path /admin /admin/* /realms/master /realms/master/* /metrics /metrics/* /health /health/*
	respond @private 404

	reverse_proxy keycloak:8080
}
