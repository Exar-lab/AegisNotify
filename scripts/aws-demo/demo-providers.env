# Non-secret provider settings for the AWS demo (issue #238), merged into .env.prod by
# load-ssm-env.sh together with the secrets stored in SSM Parameter Store.
#
# Email through Mailtrap's Send API. The notification service posts to <base-url>/api/send with the
# token as the API key, so SENDGRID_BASE_URL points at Mailtrap and SENDGRID_API_KEY is the token.
NOTIFICATION_EMAIL_PROVIDER=mailtrap
SENDGRID_BASE_URL=https://send.api.mailtrap.io
# WhatsApp through Vonage (the default base URL is Vonage's sandbox).
NOTIFICATION_WHATSAPP_PROVIDER=vonage
# AI aggregation with Groq (docs/aggregation.md).
NOTIFICATION_AGGREGATION_ENABLED=true
AGGREGATION_LLM_VENDOR=groq
