# Local development only — never use these values in production.
# Copy to `.env` (already gitignored) before running `docker compose up`.

# Keycloak admin console bootstrap credentials (docker-compose `keycloak` service).
# Keycloak 26 uses KC_BOOTSTRAP_ADMIN_* -- the older KEYCLOAK_ADMIN* vars are deprecated.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# aegis realm / aegis-dev-cli client used by the documented local JWT
# retrieval curl (see README) -- matches docker/keycloak/aegis-realm.json.
KEYCLOAK_BASE_URL=http://localhost:8088
KEYCLOAK_REALM=aegis
KEYCLOAK_DEV_CLIENT_ID=aegis-dev-cli
KEYCLOAK_DEV_USERNAME=aegis-dev
KEYCLOAK_DEV_PASSWORD=dev123

# PostgreSQL (docker-compose.full.yml `postgres` service / notification service datastore).
# Override the container's defaults here if needed -- must stay in sync with DB_URL/DB_USERNAME/
# DB_PASSWORD if changed (see README > Configuration).
POSTGRES_DB=aegisnotify
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis

# MongoDB (docker-compose.full.yml `mongo` service / audit service datastore).
# No authentication is configured for local development -- nothing to set here.

# Kafka (docker-compose.full.yml `kafka` service, KRaft mode, single node).
# Matches the notification/audit services' default KAFKA_BOOTSTRAP_SERVERS.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
