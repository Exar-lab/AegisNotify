# Production (single-VM demo) settings for docker-compose.prod.yml, issue #236.
#
# Copy to `.env.prod` ON THE SERVER and fill it in, or let `scripts/deploy init <public-ip>`
# create it and generate the secrets. Never commit `.env.prod` (it is gitignored) and never
# reuse the local-development values from `.env.example`.
#
# Values are read by Docker Compose as `KEY=value` (no quotes, no spaces around `=`).
# Generate secrets with `openssl rand -hex 24`. Keep them URL-safe (hex or alphanumeric):
# the Eureka and Config Server passwords are embedded in URLs, and the Keycloak realm
# values are rendered with sed, so avoid the characters | & \ in them.
#
# `docker compose --env-file .env.prod -f docker-compose.prod.yml config` fails fast and names
# any required variable that is missing. Any value containing CHANGE_ME is rejected by
# `scripts/deploy check`.

# --- Public hostname -------------------------------------------------------------------------
# Derived from the VM public IP with dashes plus ".sslip.io", for example 203.0.113.10 becomes
# 203-0-113-10.sslip.io. Subdomains are used: app., api. and auth. in front of this value.
# If the public IP changes, update this value and redeploy (docs/deploy-vm.md).
PUBLIC_HOST=CHANGE_ME

# Contact address for Let's Encrypt / ZeroSSL (expiry notices; ZeroSSL fallback needs it).
ACME_EMAIL=CHANGE_ME

# Certificate issuer policy directory: ./docker/caddy/acme-default (Let's Encrypt, then ZeroSSL)
# or ./docker/caddy/acme-staging (Let's Encrypt staging, untrusted certs, for rehearsals).
ACME_DIR=./docker/caddy/acme-default

# Origin that serves the admin SPA: the Vercel production URL, for example
# https://aegis-notify.vercel.app (scheme + host, no path, no trailing slash). REQUIRED.
# The gateway CORS allows exactly this one origin, and the Keycloak client redirect URIs and web
# origin are rendered from it (first start only; see docs/deploy-vm.md). Vercel preview URLs are
# different origins and will not be able to log in.
FRONTEND_ORIGIN=https://CHANGE_ME.vercel.app

# Compose profiles. Empty by default: the SPA is hosted on Vercel. To serve it from this VM
# instead, set COMPOSE_PROFILES=frontend and FRONTEND_ORIGIN=https://app.<PUBLIC_HOST>.
COMPOSE_PROFILES=

# Source range allowed to open the Keycloak admin console (/admin and the master realm). Default:
# nobody (a documentation address). To use it, set your own address, for example 198.51.100.7/32.
# ADMIN_ALLOWED_CIDR=

# --- Keycloak --------------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Secret of the aegis-user-service client; rendered into the realm and read by the user service.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Password of the demo login user `aegis-dev` (realm import), used in the browser login form.
# It is the credential you hand to anyone who opens the demo, so use something you are
# comfortable sharing.
DEMO_USER_PASSWORD=CHANGE_ME

# --- Data stores and service credentials -----------------------------------------------------
POSTGRES_DB=aegisnotify
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME

EUREKA_SECURITY_USER=eureka
EUREKA_SECURITY_PASSWORD=CHANGE_ME

CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=CHANGE_ME

# Base64 of 32 random bytes (`openssl rand -base64 32`). Encrypts recipients in the audit store.
# Back it up with the volumes: losing it makes stored recipients unreadable.
AUDIT_ENCRYPTION_KEY=CHANGE_ME

# --- Notification providers (optional) -------------------------------------------------------
# Unset values fall back to `local-placeholder`: the stack starts, but real deliveries fail
# against the vendor APIs. Set real credentials only if the demo must send real messages.
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# FCM_PROJECT_ID=
# FCM_ACCESS_TOKEN=

# --- AI aggregation (optional, off by default; see docs/aggregation.md) ----------------------
# NOTIFICATION_AGGREGATION_ENABLED=false
# NOTIFICATION_AGGREGATION_WINDOW=PT5M
# AGGREGATION_LLM_VENDOR=groq
# AGGREGATION_LLM_GROQ_API_KEY=
# AGGREGATION_LLM_API_KEY=
